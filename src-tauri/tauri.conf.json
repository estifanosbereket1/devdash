{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devdash",
  "version": "0.1.0",
  "identifier": "com.estifanos.devdash",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
       {
         "title": "devdash",
         "width": 64,
         "height": 64,
         "transparent": true,
         "decorations": false,
         "alwaysOnTop": true,
         "skipTaskbar": true,
         "resizable": false,
         "shadow": false
       }
     ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Floating developer dashboard for Linux",
    "longDescription": "A floating always-on-top dashboard for Linux developers: systemd units, Docker, project scanning with Compose awareness, ports, cron jobs, a REST client, a database client, a tunnel viewer, notes, tasks, and a journal, all behind a command palette.",
    "homepage": "https://github.com/estifanosbereket1/devdash",
    "linux": {
      "deb": {
        "desktopTemplate": "templates/deb-desktop.hbs"
      }
    }
  }
}
